<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:app="clr-namespace:YoutubeMusicNative"
                    xmlns:inf="clr-namespace:YoutubeMusicNative.Infrastructure"
                    xmlns:m="clr-namespace:YoutubeMusicNative.Models"
                    xmlns:vm="clr-namespace:YoutubeMusicNative.ViewModels"
                    xmlns:v="clr-namespace:YoutubeMusicNative.Views">

    <!-- Round play button that appears over artwork on hover -->
    <Style x:Key="PlayFab" TargetType="Button">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="#B3000000" CornerRadius="20" RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="scale" />
                        </Border.RenderTransform>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0,0,0" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#E6000000" />
                            <Setter TargetName="bd" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="1.1" ScaleY="1.1" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Cards ===== -->
    <DataTemplate x:Key="CardTemplate" DataType="{x:Type m:MediaItem}">
        <Grid x:Name="root" Width="176" Margin="0,0,20,16" Background="Transparent">
            <Button Style="{StaticResource BareButton}" ToolTip="{Binding Title}"
                    Command="{Binding Source={x:Static app:App.Vm}, Path=OpenCommand}" CommandParameter="{Binding}">
                <StackPanel>
                    <Grid x:Name="artBox" Height="176">
                        <Border x:Name="art" CornerRadius="4" inf:Img.Size="200" inf:Img.Url="{Binding Thumbnail}" />
                        <Border x:Name="shade" CornerRadius="4" Background="{StaticResource ShadeBrush}" Visibility="Collapsed" />
                    </Grid>
                    <TextBlock x:Name="title" Text="{Binding Title}" Margin="0,10,0,0" FontSize="15" FontWeight="SemiBold"
                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="40" />
                    <TextBlock x:Name="sub" Text="{Binding Subtitle}" Margin="0,3,0,0" FontSize="14"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="38" />
                </StackPanel>
            </Button>
            <Button x:Name="play" Style="{StaticResource PlayFab}" Content="&#xF5B0;" Visibility="Collapsed"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,124,12,0"
                    Command="{Binding Source={x:Static app:App.Vm}, Path=PlayCommand}" CommandParameter="{Binding}" />
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsWide}" Value="True">
                <Setter TargetName="root" Property="Width" Value="312" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsRound}" Value="True">
                <Setter TargetName="art" Property="CornerRadius" Value="88" />
                <Setter TargetName="shade" Property="CornerRadius" Value="88" />
                <Setter TargetName="title" Property="TextAlignment" Value="Center" />
                <Setter TargetName="sub" Property="TextAlignment" Value="Center" />
            </DataTrigger>
            <Trigger SourceName="root" Property="IsMouseOver" Value="True">
                <Setter TargetName="shade" Property="Visibility" Value="Visible" />
                <Setter TargetName="play" Property="Visibility" Value="Visible" />
            </Trigger>
            <DataTrigger Binding="{Binding CanPlay}" Value="False">
                <Setter TargetName="play" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate x:Key="ChipTemplate" DataType="{x:Type m:MediaItem}">
        <Button Style="{StaticResource BareButton}" Width="176" Height="48" Margin="0,0,16,12"
                Command="{Binding Source={x:Static app:App.Vm}, Path=OpenCommand}" CommandParameter="{Binding}">
            <Border x:Name="bd" Background="{StaticResource HoverBrush}" CornerRadius="6">
                <Grid>
                    <Border Width="6" HorizontalAlignment="Left" CornerRadius="6,0,0,6" Background="{Binding AccentColor}" />
                    <TextBlock Text="{Binding Title}" Margin="18,0,10,0" VerticalAlignment="Center"
                               FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                </Grid>
            </Border>
        </Button>
        <DataTemplate.Triggers>
            <Trigger SourceName="bd" Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{StaticResource PressedBrush}" />
            </Trigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <v:CardTemplateSelector x:Key="CardSelector" Card="{StaticResource CardTemplate}" Chip="{StaticResource ChipTemplate}" />

    <!-- ===== Page rows ===== -->

    <DataTemplate DataType="{x:Type vm:TrackRow}">
        <Border x:Name="bd" Height="56" Background="Transparent" CornerRadius="4"
                BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1">
            <Border.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Play next" CommandParameter="{Binding Item}"
                              Command="{Binding Source={x:Static app:App.Vm}, Path=PlayNextCommand}" />
                    <MenuItem Header="Add to queue" CommandParameter="{Binding Item}"
                              Command="{Binding Source={x:Static app:App.Vm}, Path=AddToQueueCommand}" />
                    <MenuItem Header="Start radio" CommandParameter="{Binding Item}"
                              Command="{Binding Source={x:Static app:App.Vm}, Path=PlayCommand}" />
                    <MenuItem Header="Go to artist" CommandParameter="{Binding Item}"
                              Command="{Binding Source={x:Static app:App.Vm}, Path=GoToArtistCommand}" />
                    <MenuItem Header="Go to album" CommandParameter="{Binding Item}"
                              Command="{Binding Source={x:Static app:App.Vm}, Path=GoToAlbumCommand}" />
                </ContextMenu>
            </Border.ContextMenu>
            <Button Style="{StaticResource BareButton}" Command="{Binding Shelf.PlayItemCommand}" CommandParameter="{Binding Item}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="40" Height="40">
                        <Border x:Name="thumb" CornerRadius="2" inf:Img.Size="60" inf:Img.Url="{Binding Item.Thumbnail}" />
                        <TextBlock x:Name="index" Text="{Binding Item.Index}" Visibility="Collapsed"
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="15"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Border x:Name="overlay" CornerRadius="2" Background="{StaticResource ShadeBrush}" Visibility="Collapsed">
                            <TextBlock x:Name="overlayIcon" Text="&#xF5B0;" FontFamily="{StaticResource IconFont}" FontSize="16"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,16,0">
                        <TextBlock x:Name="title" Text="{Binding Item.Title}" FontSize="15" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Item.Subtitle}" FontSize="14" Margin="0,2,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding Item.Duration}" Margin="0,0,16,0" FontSize="14"
                               Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                </Grid>
            </Button>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Shelf.ShowIndex}" Value="True">
                <Setter TargetName="thumb" Property="Visibility" Value="Hidden" />
                <Setter TargetName="index" Property="Visibility" Value="Visible" />
                <Setter TargetName="overlay" Property="Background" Value="Transparent" />
            </DataTrigger>
            <Trigger SourceName="bd" Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{StaticResource HoverBrush}" />
                <Setter TargetName="overlay" Property="Visibility" Value="Visible" />
                <Setter TargetName="index" Property="Visibility" Value="Hidden" />
            </Trigger>
            <DataTrigger Binding="{Binding Item.IsCurrent}" Value="True">
                <Setter TargetName="overlay" Property="Visibility" Value="Visible" />
                <Setter TargetName="overlayIcon" Property="Text" Value="&#xE767;" />
                <Setter TargetName="index" Property="Visibility" Value="Hidden" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:CarouselRow}">
        <v:CarouselShelfView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:GridRow}">
        <StackPanel Margin="0,8,0,24">
            <TextBlock Text="{Binding Shelf.Title}" FontFamily="{StaticResource DisplayFont}" FontSize="24" FontWeight="Bold"
                       Margin="0,0,0,16" Visibility="{Binding Shelf.Title, Converter={StaticResource NullToVis}}" />
            <ItemsControl ItemsSource="{Binding Shelf.Items}" ItemTemplateSelector="{StaticResource CardSelector}" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:ShelfHeaderRow}">
        <TextBlock Text="{Binding Shelf.Title}" FontFamily="{StaticResource DisplayFont}" FontSize="24" FontWeight="Bold"
                   Margin="0,28,0,12" TextTrimming="CharacterEllipsis" />
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:TitleRow}">
        <StackPanel Margin="0,28,0,16">
            <TextBlock Text="{Binding Title}" FontFamily="{StaticResource DisplayFont}" FontSize="32" FontWeight="Bold"
                       TextWrapping="Wrap" />
            <TextBlock Text="{Binding Subtitle}" Margin="0,6,0,0" Foreground="{StaticResource TextSecondaryBrush}"
                       Visibility="{Binding Subtitle, Converter={StaticResource NullToVis}}" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:DetailHeaderRow}">
        <Grid Margin="0,32,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border x:Name="art" Width="240" Height="240" CornerRadius="8" VerticalAlignment="Top"
                    inf:Img.Size="320" inf:Img.Url="{Binding Header.Thumbnail}" />
            <StackPanel x:Name="info" Grid.Column="1" Margin="32,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="title" Text="{Binding Header.Title}" FontFamily="{StaticResource DisplayFont}" FontSize="36" FontWeight="Bold"
                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="100" />
                <TextBlock Text="{Binding Header.Strapline}" Margin="0,12,0,0" FontSize="16" FontWeight="SemiBold"
                           Visibility="{Binding Header.Strapline, Converter={StaticResource NullToVis}}" />
                <TextBlock Text="{Binding Header.Subtitle}" Margin="0,8,0,0" Foreground="{StaticResource TextSecondaryBrush}"
                           TextWrapping="Wrap" Visibility="{Binding Header.Subtitle, Converter={StaticResource NullToVis}}" />
                <TextBlock Text="{Binding Header.SecondSubtitle}" Margin="0,4,0,0" Foreground="{StaticResource TextSecondaryBrush}"
                           Visibility="{Binding Header.SecondSubtitle, Converter={StaticResource NullToVis}}" />
                <TextBlock Text="{Binding Header.Description}" Margin="0,12,0,0" Foreground="{StaticResource TextSecondaryBrush}"
                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="60"
                           Visibility="{Binding Header.Description, Converter={StaticResource NullToVis}}" />
                <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                    <Button Style="{StaticResource PillButton}" Command="{Binding Page.PlayAllCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xF5B0;" FontFamily="{StaticResource IconFont}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Play" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource PillOutlineButton}" Margin="12,0,0,0" Command="{Binding Page.ShuffleCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B1;" FontFamily="{StaticResource IconFont}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Shuffle" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Source={x:Static app:App.Vm}, Path=IsNarrow}" Value="True">
                <Setter TargetName="art" Property="Width" Value="128" />
                <Setter TargetName="art" Property="Height" Value="128" />
                <Setter TargetName="info" Property="Margin" Value="16,0,0,0" />
                <Setter TargetName="title" Property="FontSize" Value="24" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:ArtistHeaderRow}">
        <Grid x:Name="root" Height="340" Margin="0,24,0,16">
            <Border CornerRadius="12" inf:Img.Size="1100" inf:Img.Url="{Binding Header.Thumbnail}" />
            <Border CornerRadius="12">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#00030303" Offset="0.25" />
                        <GradientStop Color="#F2030303" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <StackPanel VerticalAlignment="Bottom" Margin="32,0,32,28">
                <TextBlock x:Name="title" Text="{Binding Header.Title}" FontFamily="{StaticResource DisplayFont}" FontSize="52" FontWeight="Bold"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Header.Subtitle}" Margin="0,4,0,0" Foreground="{StaticResource TextSecondaryBrush}"
                           Visibility="{Binding Header.Subtitle, Converter={StaticResource NullToVis}}" />
                <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                    <Button Style="{StaticResource PillButton}" Command="{Binding Page.ShuffleCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B1;" FontFamily="{StaticResource IconFont}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Shuffle" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource PillOutlineButton}" Margin="12,0,0,0" Command="{Binding Page.PlayAllCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xF5B0;" FontFamily="{StaticResource IconFont}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Play" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Source={x:Static app:App.Vm}, Path=IsNarrow}" Value="True">
                <Setter TargetName="root" Property="Height" Value="240" />
                <Setter TargetName="title" Property="FontSize" Value="32" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:MessageRow}">
        <StackPanel Margin="0,64,0,64" HorizontalAlignment="Center">
            <TextBlock Text="{Binding Text}" FontSize="16" Foreground="{StaticResource TextSecondaryBrush}"
                       TextWrapping="Wrap" TextAlignment="Center" MaxWidth="520" />
            <Button Style="{StaticResource PillButton}" Margin="0,20,0,0" HorizontalAlignment="Center"
                    Content="{Binding ActionText}" Command="{Binding Action}"
                    Visibility="{Binding ActionText, Converter={StaticResource NullToVis}}" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:LoadingRow}">
        <Control Style="{StaticResource Spinner}" Margin="0,24" HorizontalAlignment="Center" />
    </DataTemplate>

</ResourceDictionary>
