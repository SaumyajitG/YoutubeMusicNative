<UserControl x:Class="YoutubeMusicNative.Views.PlayerBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:inf="clr-namespace:YoutubeMusicNative.Infrastructure">
    <Grid Height="72" Background="{StaticResource PlayerBgBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Seek bar sits on the top edge, like YouTube Music -->
        <Slider x:Name="Seek" Grid.ColumnSpan="3" Style="{StaticResource ThinSlider}" Tag="3"
                VerticalAlignment="Top" Margin="0,-8,0,0" Minimum="0"
                Maximum="{Binding Player.Duration, Mode=OneWay}" Value="{Binding Player.Position, Mode=OneWay}"
                PreviewMouseLeftButtonDown="OnSeekStart" PreviewMouseLeftButtonUp="OnSeekEnd" />

        <!-- Transport -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
            <Button Style="{StaticResource IconButton}" Content="&#xE892;" FontSize="20" ToolTip="Previous"
                    Command="{Binding PreviousCommand}" />
            <Grid Width="52" Height="52" Margin="4,0">
                <Button x:Name="PlayButton" Width="52" Height="52" FontSize="28"
                        Command="{Binding TogglePlayCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                            <Setter Property="Content" Value="&#xF5B0;" />
                            <Setter Property="ToolTip" Value="Play" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Player.IsPlaying}" Value="True">
                                    <Setter Property="Content" Value="&#xE769;" />
                                    <Setter Property="ToolTip" Value="Pause" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Control Style="{StaticResource Spinner}" Width="52" Height="52" Foreground="#80FFFFFF" IsHitTestVisible="False"
                         Visibility="{Binding Player.IsBuffering, Converter={StaticResource BoolToVis}}" />
            </Grid>
            <Button Style="{StaticResource IconButton}" Content="&#xE893;" FontSize="20" ToolTip="Next"
                    Command="{Binding NextCommand}" />
            <TextBlock Text="{Binding Player.TimeText}" Margin="12,0,8,0" VerticalAlignment="Center" FontSize="12"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Visibility="{Binding IsNarrow, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
        </StackPanel>

        <!-- Now playing -->
        <Button Grid.Column="1" Style="{StaticResource BareButton}" Margin="16,0" Command="{Binding ToggleQueueCommand}"
                ToolTip="Up next" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="40" Height="40" CornerRadius="2" inf:Img.Size="60" inf:Img.Url="{Binding Player.Current.Thumbnail}" />
                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Player.Current.Title}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Player.Current.Subtitle}" FontSize="14" Margin="0,2,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </Button>

        <!-- Volume / modes -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
            <StackPanel Orientation="Horizontal"
                        Visibility="{Binding IsNarrow, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                <Button Command="{Binding MuteCommand}" ToolTip="Mute">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                            <Setter Property="Content" Value="&#xE767;" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Player.IsMuted}" Value="True">
                                    <Setter Property="Content" Value="&#xE74F;" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Slider Width="96" Style="{StaticResource ThinSlider}" Foreground="White" VerticalAlignment="Center"
                        Minimum="0" Maximum="100" Value="{Binding Player.Volume}" Margin="0,0,8,0"
                        SmallChange="2" LargeChange="10" />
                <Button Command="{Binding RepeatCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                            <Setter Property="Content" Value="&#xE8EE;" />
                            <Setter Property="ToolTip" Value="Repeat off" />
                            <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Player.Repeat}" Value="All">
                                    <Setter Property="Foreground" Value="White" />
                                    <Setter Property="ToolTip" Value="Repeat all" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Player.Repeat}" Value="One">
                                    <Setter Property="Content" Value="&#xE8ED;" />
                                    <Setter Property="Foreground" Value="White" />
                                    <Setter Property="ToolTip" Value="Repeat one" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="&#xE8B1;" Command="{Binding ShuffleCommand}" ToolTip="Shuffle">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                            <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Player.Shuffle}" Value="True">
                                    <Setter Property="Foreground" Value="White" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
            <Button Command="{Binding ToggleQueueCommand}" ToolTip="Up next">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                        <Setter Property="Content" Value="&#xE70E;" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsQueueOpen}" Value="True">
                                <Setter Property="Content" Value="&#xE70D;" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
