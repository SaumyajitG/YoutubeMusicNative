<UserControl x:Class="YoutubeMusicNative.Views.CarouselShelfView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ItemsPanelTemplate x:Key="RowPanel">
            <StackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
        <!-- "Quick picks": 4 rows of songs flowing into columns -->
        <ItemsPanelTemplate x:Key="QuickPicksPanel">
            <WrapPanel Orientation="Vertical" Height="232" />
        </ItemsPanelTemplate>
        <Style x:Key="QuickPickContainer" TargetType="ContentPresenter">
            <Setter Property="Width" Value="400" />
            <Setter Property="Margin" Value="0,0,16,0" />
        </Style>
    </UserControl.Resources>

    <StackPanel Margin="0,20,0,20">
        <Grid Margin="0,0,0,16">
            <StackPanel VerticalAlignment="Bottom" Margin="0,0,96,0">
                <TextBlock Text="{Binding Shelf.Strapline}" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}"
                           TextTrimming="CharacterEllipsis" Margin="0,0,0,2"
                           Visibility="{Binding Shelf.Strapline, Converter={StaticResource NullToVis}}" />
                <TextBlock Text="{Binding Shelf.Title}" FontFamily="{StaticResource DisplayFont}" FontSize="24" FontWeight="Bold"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <Button x:Name="LeftButton" Style="{StaticResource CircleOutlineButton}" Content="&#xE76B;"
                        Click="OnLeft" IsEnabled="False" ToolTip="Previous" />
                <Button x:Name="RightButton" Style="{StaticResource CircleOutlineButton}" Content="&#xE76C;"
                        Margin="12,0,0,0" Click="OnRight" ToolTip="Next" />
            </StackPanel>
        </Grid>
        <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                      CanContentScroll="False" Focusable="False"
                      PreviewMouseWheel="OnPreviewMouseWheel" ScrollChanged="OnScrollChanged">
            <ItemsControl x:Name="Items" Focusable="False" />
        </ScrollViewer>
    </StackPanel>
</UserControl>
